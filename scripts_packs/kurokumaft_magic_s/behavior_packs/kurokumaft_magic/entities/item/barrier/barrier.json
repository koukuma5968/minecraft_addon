{
  "format_version": "1.21.90",
  "minecraft:entity": {
    "description": {
      "identifier": "kurokumaft:barrier",
      "spawn_category": "creature",
      "is_spawnable": false,
      "is_summonable": true
    },

    "components": {
      "minecraft:type_family": {
        "family": [ "parrot_tame", "familiar" ]
      },
      "minecraft:is_tamed": {
      },
      "minecraft:tamemount": {
        "min_temper": 0,
        "max_temper": 1
      },
      "minecraft:sittable": {
      },
      "minecraft:is_hidden_when_invisible": {
      },
      "minecraft:collision_box": {
        "width": 0.25,
        "height": 0.25
      },
      "minecraft:health": {
        "value": 30,
        "max": 30
      },
      "minecraft:damage_sensor": {
        "triggers": [
          {
            "on_damage": {
              "filters": {
                "all_of" : [
                  {"test": "is_family","operator": "equals","subject": "self","value": "player"},
                  {"test": "has_damage","operator": "equals","subject": "self","value": "attack"}
                ]
              }
            },
            "cause": "entity_attack",
            "deals_damage": "no_but_side_effects_apply"
          }
        ]
      },
      "minecraft:physics": {
      },
      "minecraft:pushable": {
        "is_pushable": true,
        "is_pushable_by_piston": true
      },
      "minecraft:conditional_bandwidth_optimization": {
      }
    }

  }
}
