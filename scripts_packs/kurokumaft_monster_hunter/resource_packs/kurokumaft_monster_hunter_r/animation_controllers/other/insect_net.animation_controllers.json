{
	"format_version": "1.19.0",
	"animation_controllers": {
		"controller.animation.insect_net.wield": {
			"initial_state": "wield_first_person",
			"states": {
				"wield_first_person": {
					"animations": ["wield_first_person"],
					"transitions": [
						{"wield_third_person": "!context.is_first_person"}
					]
				},
				"wield_third_person": {
					"animations": ["wield_third_person"],
					"transitions": [
						{"wield_first_person": "context.is_first_person"}
					]
				}
			}
		}
	}
}