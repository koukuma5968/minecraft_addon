{
  "format_version": "1.8.0",
  "render_controllers": {
    "controller.render.meat_roaster": {
      "part_visibility": [
        { "meat": "query.property('kurokumaft:mh_action') == 'roast'" },
        { "handle": "query.property('kurokumaft:mh_action') == 'roast'" }
      ],
      "arrays": {
        "textures": {
          "array.texture_frames": [
            "texture.raw",
            "texture.unfired",
            "texture.browned",
            "texture.burnt"
          ]
        }
      },
      "geometry": "Geometry.default",
      "materials": [ { "*": "Material.default" } ],
      "textures": [ "array.texture_frames[query.property('kurokumaft:roast_state')]" ]
    }
  }
}
