{
  "format_version": "1.26.0",
  "minecraft:entity": {
    "description": {
      "identifier": "kurokumaft:aptonos",
      "spawn_category": "creature",
      "is_spawnable": true,
      "is_summonable": true,
      "properties": {
        "kurokumaft:mh_action": {
          "type": "enum",
          "values": ["wait", "walk", "eat", "escape", "attack", "damage", "dizziness", "dai"],
          "default": "wait",
          "client_sync": true
        },
        "kurokumaft:health": {
          "range": [ 0, 15 ],
          "type": "int",
          "default": 15,
          "client_sync": true
        },
        "kurokumaft:mh_action_status": {
          "type": "enum",
          "values": ["none", "peacetime", "hostile", "inactive"],
          "default": "peacetime",
          "client_sync": true
        },
        "kurokumaft:peeling_count": {
          "range": [ 0, 2 ],
          "type": "int",
          "default": 2,
          "client_sync": true
        },
        "kurokumaft:ailment_state": {
          "type": "bool",
          "default": false,
          "client_sync": true
        },
        "kurokumaft:poison_gauge": {
          "range": [ 0, 100 ],
          "type": "int",
          "default": 0,
          "client_sync": true
        },
        "kurokumaft:paralysis_gauge": {
          "range": [ 0, 100 ],
          "type": "int",
          "default": 0,
          "client_sync": true
        },
        "kurokumaft:sleep_gauge": {
          "range": [ 0, 100 ],
          "type": "int",
          "default": 0,
          "client_sync": true
        },
        "kurokumaft:dizziness_gauge": {
          "range": [ 0, 100 ],
          "type": "int",
          "default": 0,
          "client_sync": true
        }
      }
    },

    "component_groups": {
      "kurokumaft:spawn_baby": {
        "minecraft:is_baby": {
        },
        "minecraft:scale": {
          "value": 0.8
        },
        "minecraft:collision_box": {
          "width": 1.3,
          "height": 0.9
        },
        "minecraft:ageable": {
          "duration": 1200,
          "feed_items": "wheat",
          "grow_up": {
            "event": "minecraft:ageable_grow_up",
            "target": "self"
          }
        }
      },
      "kurokumaft:spawn_adult": {
        "minecraft:leashable_to": {
        },
        "minecraft:collision_box": {
          "width": 2.1,
          "height": 1.5
        },
        "minecraft:rideable": {
          "seat_count": 1,
          "family_types": [
            "baby_undead"
          ],
          "seats": {
            "position": [ 0.0, 1.15, 0.0 ]
          }
        }
      },
      "kurokumaft:monster_wild": {
        "minecraft:tameable": {
          "probability": 0.33,
          "tame_items": [
            "carrot",
            "golden_carrot",
            "apple",
            "golden_apple"
          ],
          "tame_event": {
            "event": "minecraft:on_tame",
            "target": "self"
          }
        }
      },

      "kurokumaft:monster_tamed": {
        "minecraft:movement": {
          "value": 0.3
        },
        "minecraft:is_tamed": {
        },
        "minecraft:behavior.follow_owner": {
          "priority": 3,
          "speed_multiplier": 1.2,
          "start_distance": 10,
          "stop_distance": 16
        },
        "minecraft:rideable": {
          "seat_count": 2,
          "crouching_skip_interact": true,
          "family_types": [
            "player"
          ],
          "interact_text": "action.interact.ride.horse",
          "seats": [
            {
              "position": [ 0.0, 1.1, -0.5 ]
            },
            {
              "position": [ 0.0, 0.7, -0.6 ]
            }
          ]
        },
        "minecraft:strength": {
          "value": 80,
          "max": 150
        },
        "minecraft:inventory": {
          "inventory_size": 14,
          "container_type": "horse",
          "additional_slots_per_strength": 3
        },
        "minecraft:equippable": {
          "slots": [
            {
              "slot": 0,
              "item": "saddle",
              "accepted_items": [ "saddle" ],
              "on_equip": {
                "event": "minecraft:horse_saddled"
              },
              "on_unequip": {
                "event": "minecraft:horse_unsaddled"
              }
            },
            {
              "slot": 1,
              "item": "horsearmoriron",
              "accepted_items": [
                "horsearmorleather",
                "horsearmoriron",
                "horsearmorgold",
                "horsearmordiamond"
              ]
            }
          ]
        },
        "minecraft:interact": {
          "interactions": [
            {
              "play_sounds": "armor.equip_generic",
              "on_interact": {
                "filters": {
                  "all_of": [
                    {
                      "test": "is_family",
                      "subject": "other",
                      "value": "player"
                    },
                    {
                      "test": "has_equipment",
                      "domain": "hand",
                      "subject": "other",
                      "value": "chest"
                    }
                  ]
                },
                "event": "minecraft:on_chest",
                "target": "self"
              },
              "use_item": true,
              "interact_text": "action.interact.attachchest"
            }
          ]
        }
      },

      "kurokumaft:dai": {
        "minecraft:movement": {
          "value": 0
        },
        "minecraft:knockback_resistance": {
          "max": 100,
          "value": 100
        },
        "minecraft:interact": {
          "interactions": [
            {
              "on_interact": {
                "filters": {
                  "all_of": [
                    { "test": "is_family", "subject" : "other", "value" :  "player"},
                    { "test": "has_equipment", "domain": "hand", "subject": "other", "value": "kurokumaft:peeling_knife"}
                  ]
                }
              },
              "use_item": false,
              "swing": true
            }
          ]
        }
      },

      "minecraft:horse_chested": {
        "minecraft:is_chested": {
        }
      },

      "minecraft:horse_saddled": {
        "minecraft:is_saddled": {
        },
        "minecraft:input_ground_controlled": {
        },
        "minecraft:behavior.player_ride_tamed": {
        }
      }

    },

    "components": {
      "minecraft:experience_reward": {
        "on_bred": "Math.Random(1,7)",
        "on_death": "query.last_hit_by_player ? Math.Random(1,3) : 0"
      },
      "minecraft:is_hidden_when_invisible": {
      },
      "minecraft:type_family": {
        "family": [ "monster", "mob", "mh_monster", "herbivore" ]
      },
      "minecraft:damage_sensor": {
        "triggers": [
          {
            "cause": "entity_attack",
            "deals_damage": "no_but_side_effects_apply"
          },
          {
            "cause": "block_explosion",
            "deals_damage": "no_but_side_effects_apply"
          },
          {
            "cause": "entity_explosion",
            "deals_damage": "no_but_side_effects_apply"
          },
          {
            "cause": "fire",
            "deals_damage": "no_but_side_effects_apply"
          },
          {
            "cause": "fire_tick",
            "deals_damage": "no_but_side_effects_apply"
          },
          {
            "cause": "projectile",
            "deals_damage": "no_but_side_effects_apply"
          },
          {
            "cause": "sonic_boom",
            "deals_damage": "no_but_side_effects_apply"
          },
          {
            "cause": "wither",
            "deals_damage": "no_but_side_effects_apply"
          }
        ]
      },
      "minecraft:attack": {
        "damage": 1
      },
      "minecraft:movement.basic": {
      },
      "minecraft:jump.static": {
      },
      "minecraft:can_climb": {
      },
      "minecraft:breathable": {
        "total_supply": 15,
        "suffocate_time": 0
      },
      "minecraft:nameable": {
      },
      "minecraft:hurt_on_condition": {
        "damage_conditions": [
          {
            "filters": { "test": "in_lava", "subject": "self", "operator": "==", "value": true },
            "cause": "lava",
            "damage_per_tick": 4
          }
        ]
      },
      "minecraft:despawn": {
        "despawn_from_distance": {}
      },
      "minecraft:behavior.breed": {
        "priority": 3,
        "speed_multiplier": 1.0
      },
      "minecraft:behavior.tempt": {
        "priority": 4,
        "speed_multiplier": 1.25,
        "items": [
          "wheat"
        ]
      },
      "minecraft:leashable": {
      },
      "minecraft:balloonable": {
      },
      "minecraft:physics": {
      },
      "minecraft:pushable": {
        "is_pushable": true,
        "is_pushable_by_piston": true
      },
      "minecraft:conditional_bandwidth_optimization": {
      }
    },

    "events": {
      "minecraft:entity_spawned": {
        "sequence": [
          {
            "randomize": [
              {
                "weight": 95,
                "trigger": "kurokumaft:spawn_adult"
              },
              {
                "weight": 5,
                "add": {
                  "component_groups": [
                    "kurokumaft:spawn_baby"
                  ]
                }
              }
            ]
          }
        ]
      },

      "kurokumaft:dai": {
        "add": {
          "component_groups": [
            "kurokumaft:dai"
          ]
        }
      },

      "minecraft:horse_saddled": {
        "add": {
          "component_groups": [
            "minecraft:horse_saddled"
          ]
        }
      },
      "minecraft:horse_unsaddled": {
        "remove": {
          "component_groups": [
            "minecraft:horse_saddled"
          ]
        }
      },

      "minecraft:on_chest": {
        "add": {
          "component_groups": [
            "minecraft:horse_chested"
          ]
        }
      },

      "minecraft:entity_born": {
        "add": {
          "component_groups": [
            "kurokumaft:spawn_baby"
          ]
        }
      },

      "minecraft:ageable_grow_up": {
        "remove": {
          "component_groups": [
            "kurokumaft:spawn_baby"
          ]
        },
        "add": {
          "component_groups": [
            "kurokumaft:spawn_adult"
          ]
        }
      },

      "kurokumaft:spawn_adult": {
        "add": {
          "component_groups": [
            "kurokumaft:wait",
            "kurokumaft:spawn_adult"
          ]
        }
      }
    }
  }
}
