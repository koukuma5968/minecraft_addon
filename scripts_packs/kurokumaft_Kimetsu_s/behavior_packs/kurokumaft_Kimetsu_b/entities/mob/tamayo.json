            {
              "deals_damage": "yes"
            }
          ]
        }
      },
      "kurokumaft:ogre_hurt_on_condition": {
        "minecraft:hurt_on_condition": {
          "damage_conditions": [
            {
              "filters": { "test": "in_lava", "subject": "self", "operator": "==", "value": true },
              "cause": "lava",
              "damage_per_tick": 4
            },
            {
              "filters": { "test": "on_fire", "subject": "self", "operator": "equals", "value": true },
              "cause": "fire",
              "damage_per_tick": 30
            }
          ]
        },
        "minecraft:environment_sensor": {
          "triggers": [
            {
              "filters": {
                "all_of": [
                  { "test": "is_underground", "subject": "self", "operator": "equals", "value": false },
                  { "test": "light_level", "subject": "self", "operator": ">", "value": 10 },
                  { "test": "is_daytime", "subject": "self", "operator": "equals", "value": true }
                ]
              },
              "event": "kurokumaft:sun_fire"
            }
          ]
        }
      }
